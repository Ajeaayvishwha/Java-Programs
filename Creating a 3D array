22. Creating a 3D array:

import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc = new Scanner(System.in);
	    int t = sc.nextInt();
	    int r = sc.nextInt();
	    int c = sc.nextInt();
	    int a[][][] = new int[t][r][c];
	    for (int k = 0; k<t; k++){
	    	for (int i = 0; i<=r; i++){
	        	for (int j = 0; j<=c; j++)
	            		a[k][i][j] = sc.nextInt();
		}
	    }
	    for (int k = 0; k<t; k++){
	    	for (int i = 0; i<=r; i++){
	        	for (int j = 0; j<=c; j++)
	            		System.out.print(a[k][i][j] + " ");
	        	System.out.println();
		}
	    }
	    
	}
}
