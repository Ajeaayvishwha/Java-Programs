18. Take a number as input and return the sum of all of its digits:

import java.util.*;
public class Main {
    public static void main(String[] args) {
      Scanner sc = new Scanner(System.in);
      int a = sc.nextInt();
      int count = 0;
      while (a > 0) {
            count += a % 10;
            a /= 10;
      }
      System.out.print(count);
  }
}
